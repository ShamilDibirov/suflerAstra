FROM python:3.11-slim-bookworm
ENV PYTHONUNBUFFERED=1 HF_HOME=/models/huggingface TORCH_HOME=/models/torch SPEECH_DEVICE=cuda
RUN apt-get update && apt-get install -y --no-install-recommends gosu libsndfile1 libportaudio2 ffmpeg libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY services/speech/requirements.cuda.lock ./requirements.cuda.lock
RUN pip install --no-cache-dir --upgrade pip==26.2.1
RUN --mount=type=cache,id=sufler-speech-cuda-pip,target=/root/.cache/pip pip install --retries 10 --resume-retries 10 --timeout 120 --extra-index-url https://download.pytorch.org/whl/cu124 -r requirements.cuda.lock
RUN useradd --create-home worker && mkdir /models && chown worker /models
COPY --chown=worker services/speech/main.py ./main.py
COPY --chmod=755 deploy/model-entrypoint.sh /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
EXPOSE 8001
CMD ["uvicorn", "main:app", "--host", "::", "--port", "8001", "--no-access-log"]
