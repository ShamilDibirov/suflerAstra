# Local demo is explicit. Set false to require Better Auth and real services.
DEMO_MODE=true
APP_ORIGIN=http://localhost:3000
PORT=4000
HOST=127.0.0.1
DATABASE_URL=postgresql://sufler:sufler-local@localhost:5432/sufler
REDIS_URL=
BETTER_AUTH_SECRET=
INTERNAL_SERVICE_TOKEN=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
HF_TOKEN=
KEV_MODEL=jaredpalmer/kev-4b
CLASSIFIER_FALLBACK_MODEL=qwen/qwen3.5-9b
KEV_CONFIDENCE_THRESHOLD=0.85
SPEECH_URL=http://127.0.0.1:8001
KNOWLEDGE_URL=http://127.0.0.1:8002
WEAVIATE_URL=http://127.0.0.1:8080
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sufler
S3_ACCESS_KEY=sufler-local
S3_SECRET_KEY=sufler-local-secret
S3_FORCE_PATH_STYLE=true
# Provisioning only. Never commit populated secrets.
BOOTSTRAP_EMAIL=
BOOTSTRAP_NAME=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_ORG=
# Docker Compose: create a separate real env with node scripts/init-env.mjs.
POSTGRES_PASSWORD=
WEAVIATE_API_KEY=
STAFF_SIMILARITY_THRESHOLD=0.65
